<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/ui_surface"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/btnCloudLoginBack"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/ui_text_primary"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/tvCloudLoginTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ui_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloudLoginRefresh"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="↻"
                android:textColor="@color/ui_text_primary"
                android:textSize="25sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/cloudLoginProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <WebView
            android:id="@+id/cloudLoginWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/ui_bg" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cloudLoginError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="暂时无法打开网盘登录页，请检查网络后重试"
            android:textColor="@color/ui_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnCloudLoginRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_scan_floating_button"
            android:paddingLeft="22dp"
            android:paddingTop="9dp"
            android:paddingRight="22dp"
            android:paddingBottom="9dp"
            android:text="重新加载"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
